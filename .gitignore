# Go
/splitstream
/dist/
*.test
*.out

# SQLite
*.db
*.db-wal
*.db-shm

# Frontend
/web/node_modules/
/web/.quasar/
# Se excluye el CONTENIDO de dist/spa, no el directorio: git no permite reincluir un
# archivo si su directorio padre está excluido, y el .gitkeep tiene que quedar versionado
# para que el go:embed de web/embed.go resuelva en un clon que aún no ha compilado nada.
/web/dist/spa/*
!/web/dist/spa/.gitkeep

# Entorno
.env
.env.local

# macOS
.DS_Store

# El .env del despliegue lleva la clave maestra: nunca se versiona.
/deploy/.env

# Archivos de clave maestra. El binario crea uno junto a la base cuando no hay
# SPLITSTREAM_MASTER_KEY, y durante el desarrollo la base suele quedar en la raíz.
*.key
