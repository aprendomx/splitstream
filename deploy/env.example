# Guárdalo como .env junto al docker-compose.yml y rellena la clave maestra.
#
# Genérala con:
#   docker compose run --rm splitstream -genkey
#
# GUÁRDALA APARTE. Cifra las claves de tus canales: si la pierdes, son irrecuperables por
# diseño y hay que volver a pegarlas todas.
SPLITSTREAM_MASTER_KEY=

# Descomenta si sirves el panel por HTTPS detrás de un proxy. Sin esto, la cookie de
# sesión no se marca como Secure.
#SPLITSTREAM_SECURE_COOKIES=true

# Redes desde las que se cree la cabecera X-Forwarded-For (CIDR o IP, separadas por comas).
# Solo si el panel va detrás de Caddy, nginx o un proxy de Docker en la misma máquina:
# sin esto el limitador del login castigaría a todos por uno y el asistente vería todo
# como remoto. 0.0.0.0/0 anula el limitador: no lo pongas.
#SPLITSTREAM_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Con un dominio apuntando aquí y los puertos 80 y 443 abiertos, TLS integrado con
# Let's Encrypt: el binario pide y renueva el certificado solo. Ojo: Let's Encrypt limita
# a 5 certificados por semana por dominio, así que no reinicies en bucle con el
# tls-cache borrado.
#SPLITSTREAM_TLS_DOMAIN=relay.ejemplo.com

# Con SPLITSTREAM_TLS_DOMAIN el panel pasa solo a :443 y el :80 redirige a HTTPS; no hace
# falta tocar SPLITSTREAM_HTTP_ADDR (solo si quieres otro puerto).

# Dónde guarda autocert la cuenta ACME y los certificados. Por defecto, junto a la base.
# Si lo cambias, que sea un directorio escribible y persistente: borrarlo cuesta
# certificados nuevos, y son 5 por semana por dominio.
#SPLITSTREAM_TLS_CACHE_DIR=/data/tls-cache

# El listener HTTP que atiende el reto de Let's Encrypt y redirige a HTTPS. `none` lo
# desactiva (solo si otra cosa ya ocupa el :80 y sabes lo que haces).
#SPLITSTREAM_TLS_REDIRECT_ADDR=:80

# Certificado propio en PEM, en vez del dominio. Van las dos juntas.
#SPLITSTREAM_TLS_CERT_FILE=/etc/ssl/relay.crt
#SPLITSTREAM_TLS_KEY_FILE=/etc/ssl/relay.key

# Apaga la consulta diaria de versión nueva (a GitHub, solo con la versión como dato).
#SPLITSTREAM_UPDATE_CHECK=false

# debug, info, warn o error.
#SPLITSTREAM_LOG_LEVEL=info
