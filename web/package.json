{
  "name": "splitstream-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Panel web de splitstream. Se compila a dist/spa y el binario Go lo embebe.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/i18n-check.mjs",
    "build": "vite build && node -e \"require('fs').writeFileSync('dist/spa/.gitkeep','')\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "pinia": "^3.0.4",
    "quasar": "^2.32.2",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^2.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "sass-embedded": "^1.103.1",
    "vite": "^8.3.0"
  }
}
